# TEST talp_mpi_calls: --path-sensitive

# TODO: change to:  talp_fns = has_talp_metrics(%%)
bad_par_eff = talp_mpi_parallel_efficiency("<", 1, %%) # TODO: support floats
leapfrog = by_name("LagrangeLeapFrog", %%)
# TODO: support loops in the future

!instrument(join(%leapfrog, %bad_par_eff))

