#!/bin/bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
builddir=@CAPI_BIN_DIR@
capi=$builddir/src/driver/capi
testExe="$script_dir/simpleTester"

function runTestcase {
  testCaseFile=$1
  mcg=$2

  fail=0

  # Read test case lines from .capi file

  while IFS= read -r line; do
    # Skip non-test lines
    [[ "$line" =~ ^#\ TEST ]] || continue

    # Extract test name and parameters
    testName=$(echo "$line" | sed -n 's/^# TEST \([^:]*\):.*/\1/p')
    testParams=$(echo "$line" | sed -n 's/^# TEST [^:]*: \(.*\)/\1/p')

    # Construct output and ground truth filenames
    gFile=$(generateOutputFilename "$mcg" "$testName")
    gtFile="${gFile/.json/.gtjson}"

    # Run capi with parameters
    echo "Running test \"${testName}\": $capi -f $testCaseFile --output-format json $testParams -o $gFile $mcg"
    $capi -f "$testCaseFile" --output-format json $testParams -o "$gFile" "$mcg"

    # Run testExe
    $testExe "$gFile" "$gtFile"
    if [ $? -ne 0 ]; then
      fail=1
      echo "Failure for test case: $testName (file: $gFile). Keeping generated file for inspection."
    else
      rm "$gFile"
    fi
  done < "$testCaseFile"

  return $fail
}

function generateOutputFilename {
  mcgFile=$1       # Full path to .mcg file
  testName=$2      # e.g., talp_mpi_calls

  dirName=$(dirname "$mcgFile")                # e.g., path/to
  baseName=$(basename "$mcgFile" .mcg)         # e.g., lulesh_talp

  echo "${dirName}/${baseName}.${testName}.json"
}

