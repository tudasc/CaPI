CAPICC=@CAPICC@
CXX=@CXX@

VARIANT=gnu

include Makefile.$(VARIANT).include

all: main.$(VARIANT).exe shared2.$(VARIANT).so

%.$(VARIANT).o: %.cpp
	@echo "Building $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -c -o $@  $<

shared.$(VARIANT).so: shared.$(VARIANT).o
	@echo "Linking shared lib $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -shared -o $@ $<

shared2.$(VARIANT).so: shared2.$(VARIANT).o
	@echo "Linking shared lib $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -shared -o $@ $<

main.$(VARIANT).exe: main.$(VARIANT).o shared.$(VARIANT).so
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) main.$(VARIANT).o shared.$(VARIANT).so -Wl,-rpath=`pwd` -o $@

clean:
	rm -f *.o *.exe *.so
