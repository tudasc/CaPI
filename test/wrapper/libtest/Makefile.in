CAPICC=@CAPICC@
CAPI_FLAGS=--capi-interface=gnu --verbose
CXX=@CXX@

all: main.exe shared2.so

%.o: %.cpp
	@echo "Building $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -c -o $@  $<

shared.so: shared.o
	@echo "Linking shared lib $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -shared -o $@ $<

shared2.so: shared2.o
	@echo "Linking shared lib $<"
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) -shared -o $@ $<

main.exe: main.o shared.so
	$(CAPICC) $(CAPI_FLAGS) $(CXX) $(CXXFLAGS) main.o shared.so -Wl,-rpath=`pwd` -o $@

clean:
	rm -f *.o *.exe *.so
