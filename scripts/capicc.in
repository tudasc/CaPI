#!/usr/bin/env bash

export OMPI_CC=@CC_PATH@
export OMPI_CXX=@CXX_PATH@

CAPI_LIB_DSO_INIT=@CAPI_XRAY_LIB_DIR@/libcapi_dso_init.a
CAPI_LIB_GNU=@CAPI_XRAY_LIB_DIR@/libcapixray_gnu.a
CAPI_LIB_SCOREP=@CAPI_XRAY_LIB_DIR@/libcapixray_scorep.a
CAPI_LIB_EXTRAE=@CAPI_XRAY_LIB_DIR@/libcapixray_extrae.a
CAPI_LIB_TALP=@CAPI_XRAY_LIB_DIR@/libcapixray_talp.a
CAPI_LIB_NESMIK=@CAPI_XRAY_LIB_DIR@/libcapixray_nesmik.a

CAPI_SELECT_LIB=@CAPI_SELECT_LIB_DIR@/libcapi_select.so

LLVM_LIBS=$(@LLVM_CONFIG@ --libfiles xray symbolize --link-static --system-libs)

METACG_LIB="@METACG_LIBRARY@"
NESMIK_LIB="@NESMIK_LIB_PATH@"
DLB_LIB="@DLB_LIBRARY@"

XRAY_FLAGS="-fxray-instrument -fxray-shared -fxray-instruction-threshold=1"

INST_PASSES_AVAILABLE="@INST_PASSES_AVAILABLE@"

CAPI_INST_PASS=@CAPI_INST_PASS_DIR@/capi_inst.so
TALP_PASS=@CAPI_TALP_PASS_DIR@/talp_inst.so
NESMIK_PASS=@CAPI_NESMIK_PASS_DIR@/nesmik_inst.so
#CGPATCH_PASS="$(dirname "$METACG_LIB")/libcgpatch-inst-pass.so"
CGPATCH_PASS=$(metacg-config --libdir)/libcgpatch-inst-pass.so

VERBOSE=0
RUN_INST_PASS=1
RUN_CGPATCH=1
EMBED_CG=0
SHOWME_COMPILE=0
SHOWME_LDFLAGS=0
SHOWME_LIBS=0
SHOWME_LIBS_SHARED=0
SHOWME_LINK=0
SHOWME_ALL=0
SHOWME_COMMAND=0

# -------------------------------
# Helper: CaGe flags
# -------------------------------
get_cage_link_flags() {
    echo $(metacg-config --cage-ldflags)
}

get_cage_compile_flags() {
    echo $(metacg-config --cage-cxxflags)
}

get_cgpatch_compile_flags() {
  echo "-fwhole-program-vtables"
}

get_cgpatch_link_flags() {
  local flags="-Wl,-mllvm=-load=$CGPATCH_PASS -Wl,--load-pass-plugin=$CGPATCH_PASS"
  if [[ "$VERBOSE" == 1 ]]; then
          flags="$flags -Wl,-mllvm=-cgpatch-verbose"
  fi
  echo "$flags"
}

# -------------------------------
# Helper: instrumentation command
# -------------------------------
get_inst_cmd() {
    local iface=$1
    case "$iface" in
        gnu_static)
            echo "-Xclang -load -Xclang $CAPI_INST_PASS \
-fpass-plugin=$CAPI_INST_PASS -mllvm -inst-api=gnu"
            ;;
        talp_static)
            echo "-Xclang -load -Xclang $CAPI_INST_PASS \
-Xclang -load -Xclang $TALP_PASS \
-fpass-plugin=$CAPI_INST_PASS -fpass-plugin=$TALP_PASS \
-mllvm -inst-api=talp"
            ;;
        nesmik)
            if [[ "$RUN_INST_PASS" == 1 ]]; then
                echo "-Xclang -load -Xclang $NESMIK_PASS \
-fpass-plugin=$NESMIK_PASS $XRAY_FLAGS"
            else
                echo "$XRAY_FLAGS"
            fi
            ;;
        *)
            echo "$XRAY_FLAGS"
            ;;
    esac
}

get_compile_flags() {
    local flags
    flags="$(get_inst_cmd "$CAPI_INTERFACE")"

    if [[ "$EMBED_CG" == 1 ]]; then
        flags="$flags $(get_cage_compile_flags)"
        if [[ "$RUN_CGPATCH" == 1 ]]; then
            flags="$flags $(get_cgpatch_compile_flags)"
        fi
    fi

    echo "$flags"
}
# -------------------------------
# Helper: wrap with whole-archive
# -------------------------------
wrap_whole_archive() {
    local libs="$*"
    echo -n "-Wl,-whole-archive $libs -Wl,-no-whole-archive"
}

# -------------------------------
# Helper: link DSO with rpath
# -------------------------------
link_with_rpath() {
  local lib="$*"
  echo -n "-Wl,-rpath,$(dirname $lib) $lib"
}

# -------------------------------
# Helpers: Score-P setup
# -------------------------------
prepare_scorep_init() {
    # Generate init file + object
    @SCOREP_CONFIG@ --mpp=mpi --adapter-init --compiler > scorep_init.c
    $COMPILER -c -x c scorep_init.c
}

get_ldflags() {
    local flags=""

    case "$CAPI_INTERFACE" in
        scorep)
            flags="$(@SCOREP_CONFIG@ --compiler --ldflags) $XRAY_FLAGS"
            ;;
        gnu|scorep|extrae|talp|nesmik)
            flags="$XRAY_FLAGS"
            ;;
    esac

    if [[ "$EMBED_CG" == 1 ]]; then
        flags="$flags $(get_cage_link_flags)"
        if [[ "$RUN_CGPATCH" == 1 ]]; then
          flags="$flags $(get_cgpatch_link_flags)"
        fi
    fi

    echo "$flags"
}


get_libs() {
    local libs=""

    case "$CAPI_INTERFACE" in
        gnu)
            libs="$(wrap_whole_archive $CAPI_LIB_GNU) $(link_with_rpath $CAPI_SELECT_LIB) $METACG_LIB $LLVM_LIBS -lstdc++"
            ;;
        scorep)
            libs="$(wrap_whole_archive $CAPI_LIB_SCOREP) $(link_with_rpath $CAPI_SELECT_LIB) $METACG_LIB $(@SCOREP_CONFIG@ --libs --mpp=mpi --compiler) $LLVM_LIBS -lstdc++"
            ;;
        extrae)
            libs="$(wrap_whole_archive $CAPI_LIB_EXTRAE) $(link_with_rpath $CAPI_SELECT_LIB) $METACG_LIB $LLVM_LIBS -lstdc++"
            ;;
        talp)
            libs="$(wrap_whole_archive $CAPI_LIB_TALP) $(link_with_rpath $CAPI_SELECT_LIB) $METACG_LIB $LLVM_LIBS -lstdc++"
            ;;
        nesmik)
            libs="$(wrap_whole_archive $CAPI_LIB_NESMIK) $(link_with_rpath $CAPI_SELECT_LIB) $METACG_LIB $NESMIK_LIB $DLB_LIB $LLVM_LIBS -lmpi -lstdc++"
            ;;
        gnu_static|talp_static)
            libs=""
            ;;
    esac

    echo "$libs"
}

# Library dependencies that are injected into shared libraries
get_libs_shared() {
    local libs=""

    case "$CAPI_INTERFACE" in
        gnu|scorep|extrae|talp|nesmik)
            libs="$(wrap_whole_archive $CAPI_LIB_DSO_INIT)"
            ;;
        gnu_static|talp_static)
            libs=""
            ;;
    esac

    echo "$libs"
}


# -------------------------------
# Parse wrapper options
# -------------------------------
for arg in "$@"; do
    case $arg in
        --capi-interface=*)
            CAPI_INTERFACE="${arg#*=}"
            shift
            ;;
        --embed-cg)
            EMBED_CG=1
            shift
            ;;
        --no-instrument)
            RUN_INST_PASS=0
            shift
            ;;
        --showme:compile)
            SHOWME_COMPILE=1
            shift
            ;;
        --showme:ldflags)
            SHOWME_LDFLAGS=1
            shift
            ;;
        --showme:libs)
            SHOWME_LIBS=1
            shift
            ;;
        --showme::libs_shared)
            SHOWME_LIBS_SHARED=1
            shift
            ;;
        --showme:link)
            SHOWME_LINK=1
            shift
            ;;
        --showme:all)
            SHOWME_ALL=1
            shift
            ;;
        --showme:command)
            SHOWME_COMMAND=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -*)
            echo "Unknown wrapper option $arg" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# -------------------------------
# Checking for inconsistencies
# -------------------------------
if [[ "$RUN_INST_PASS" -eq 1 ]] && [[ "$INST_PASSES_AVAILABLE" -eq 0 ]]; then
    echo "Instrumentation plugins not available. Build CaPI with ENABLE_INST_PASSES=ON or disable LLVM instrumentation plugins by passing --no-instrument to this wrapper." >&2
    exit 1
fi

# set first argument as compiler
COMPILER=$1
shift

# Check if linking or not
linking=yes
shared=no
for arg in "$@"; do
    case "$arg" in
        -c|-S|-E|-M|-MM|-MMD)
            linking=no
            ;;
        -shared|-Wl,-shared)
            shared=yes
            ;;
    esac
done

CMD=""

if [[ "$linking" == yes ]]; then
    EXTRA_OBJS=""

    case "$CAPI_INTERFACE" in
        scorep)
            prepare_scorep_init
            EXTRA_OBJS="scorep_init.o"
            ;;
        gnu_static|talp_static|gnu|talp|nesmik|extrae)
            ;;
        *)
            echo "Invalid interface" >&2
            exit 1
            ;;
    esac

    CMD="$COMPILER $(get_compile_flags) $@ $(get_ldflags)"

    # Only executables get libraries
    if [[ "$shared" == yes ]]; then
        CMD="$CMD $(get_libs_shared)"
    else
       CMD="$CMD $EXTRA_OBJS $(get_libs)"
    fi
else
# -------------------------------
# Non-linking case
# -------------------------------
    CMD="$COMPILER $(get_compile_flags) $@"
fi


if [[ "$SHOWME_COMPILE" == 1 ]]; then
    echo -n "$(get_compile_flags)"
    exit 0
fi

if [[ "$SHOWME_LDFLAGS" == 1 ]]; then
    echo -n "$(get_ldflags)"
    exit 0
fi

if [[ "$SHOWME_LIBS" == 1 ]]; then
    echo -n "$(get_libs)"
    exit 0
fi

if [[ "$SHOWME_LIBS_SHARED" == 1 ]]; then
    echo -n "$(get_libs_SHARED)"
    exit 0
fi

if [[ "$SHOWME_LINK" == 1 ]]; then
    if [[ "$shared" == no ]]; then
        echo -n "$(get_ldflags) $(get_libs)"
    else
        echo -n "$(get_ldflags) $(get_libs_shared)"
    fi
    exit 0
fi


if [[ "$SHOWME_ALL" == 1 ]]; then
    if [[ "$shared" == no ]]; then
        echo -n "$(get_compile_flags) $(get_ldflags) $(get_libs)"
    else
        echo -n "$(get_compile_flags) $(get_ldflags) $(get_libs_shared)"
    fi
    exit 0
fi


if [[ "$SHOWME_COMMAND" == 1 ]]; then
    echo -n "$CMD"
    exit 0
fi

# -------------------------------
# Verbose output
# -------------------------------
if [[ "$VERBOSE" == 1 ]]; then
    API_INFO=""
    if [[ -n $CAPI_INTERFACE ]]; then
        API_INFO=" (api=$CAPI_INTERFACE)"
    fi
    echo "Compiler command${API_INFO}: $CMD"
fi

eval $CMD
