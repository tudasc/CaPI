#default build suggestion of MPI + OPENMP with gcc on Livermore machines you might have to change the compiler name

SHELL = /bin/sh
.SUFFIXES: .cc .o

LULESH_EXEC = lulesh2.0
LULESH_EXEC_SCOREP = lulesh2.0_scorep
LULESH_EXEC_EXTRAE = lulesh2.0_extrae
LULESH_EXEC_NESMIK = lulesh2.0_nesmik
LULESH_EXEC_NESMIK_XRAY = lulesh2.0_nesmik_xray

MPI_INC = /opt/local/include/openmpi
MPI_LIB = /opt/local/lib

#export OMPI_CC=@CC_PATH@
#export OMPI_CXX=@CXX_PATH@

SERCXX = @CXX_PATH@ -DUSE_MPI=0
MPICXX = mpic++ -DUSE_MPI=1
CAPICC = ./../../scripts/capicc
CXX = $(MPICXX)
VARIANT = scorep

SOURCES2.0 = \
	lulesh.cc \
	lulesh-comm.cc \
	lulesh-viz.cc \
	lulesh-util.cc \
	lulesh-init.cc
OBJECTS2.0 = $(SOURCES2.0:.cc=.o)

CXXFLAGS = -O3 -I. -Wall -g
LDFLAGS = -O3 -g

include Makefile.$(VARIANT).include

.cc.o: lulesh.h
	@echo "Building $<"
	$(CAPICC) $(CAPI_FLAGS) --verbose $(CXX) -c $(CXXFLAGS) -o $@  $<

all: $(LULESH_EXEC)_$(VARIANT)

$(LULESH_EXEC)_$(VARIANT): $(OBJECTS2.0)
	@echo "Linking $(VARIANT)"
	$(CAPICC) $(CAPI_FLAGS) --verbose $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

clean:
	/bin/rm -f *.o *~ $(OBJECTS) $(LULESH_EXEC) $(LULESH_EXEC_SCOREP) $(LULESH_EXEC_EXTRAE) $(LULESH_EXEC_NESMIK) $(LULESH_EXEC_NESMIK_XRAY) scorep_init.c
	/bin/rm -rf *.dSYM

tar: clean
	cd .. ; tar cvf lulesh-2.0.tar LULESH-2.0 ; mv lulesh-2.0.tar LULESH-2.0
