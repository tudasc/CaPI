#default build suggestion of MPI + OPENMP with gcc on Livermore machines you might have to change the compiler name

SHELL = /bin/sh
.SUFFIXES: .cc .o

LULESH_EXEC = lulesh2.0
LULESH_EXEC_SCOREP = lulesh2.0_scorep
LULESH_EXEC_EXTRAE = lulesh2.0_extrae
LULESH_EXEC_NESMIK = lulesh2.0_nesmik

MPI_INC = /opt/local/include/openmpi
MPI_LIB = /opt/local/lib

#export OMPI_CC=@CC_PATH@
#export OMPI_CXX=@CXX_PATH@

SERCXX = @CXX_PATH@ -DUSE_MPI=0
MPICXX = mpic++ -DUSE_MPI=1
CAPICC = ./../../scripts/capi-cxx
CXX = $(MPICXX)

SOURCES2.0 = \
	lulesh.cc \
	lulesh-comm.cc \
	lulesh-viz.cc \
	lulesh-util.cc \
	lulesh-init.cc
OBJECTS2.0 = $(SOURCES2.0:.cc=.o)

CXXFLAGS = -O3 -I. -Wall -g
LDFLAGS = -O3 -g

.cc.o: lulesh.h
	@echo "Building $<"
	$(CAPICC) --verbose $(CXX) -c $(CXXFLAGS) -o $@  $<

all: $(LULESH_EXEC) $(LULESH_EXEC_SCOREP) $(LULESH_EXEC_EXTRAE) $(LULESH_EXEC_NESMIK)


$(LULESH_EXEC): $(OBJECTS2.0)
	@echo "Linking vanilla"
	$(CAPICC) --verbose --capi-interface=gnu $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

$(LULESH_EXEC_SCOREP): $(OBJECTS2.0)
	@echo "Linking Score-P"
	$(CAPICC) --verbose --capi-interface=scorep $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

$(LULESH_EXEC_EXTRAE): $(OBJECTS2.0)
	@echo "Linking Extrae"
	$(CAPICC) --verbose --capi-interface=extrae $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

$(LULESH_EXEC_NESMIK): $(OBJECTS2.0)
	@echo "Linking neSmiK"
	$(CAPICC) --verbose --capi-interface=nesmik $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

clean:
	/bin/rm -f *.o *~ $(OBJECTS) $(LULESH_EXEC) $(LULESH_EXEC_SCOREP) $(LULESH_EXEC_EXTRAE) $(LULESH_EXEC_NESMIK) scorep_init.c
	/bin/rm -rf *.dSYM

tar: clean
	cd .. ; tar cvf lulesh-2.0.tar LULESH-2.0 ; mv lulesh-2.0.tar LULESH-2.0
